# Safe configuration template only. Never put real credentials in this file.
PEERARENA_PORT=4174
PEERARENA_MODE=demo
PEERARENA_CURRENCY=DEMO

# Application/runtime mode. Keep these values for local and preview environments.
APP_ENV=demo
AUTH_MODE=demo
PAYMENT_MODE=mock
PAYMENT_PROVIDER=mock
REAL_MONEY_ENABLED=false
MOCK_PAYMENTS_ENABLED=true
GOOGLE_AUTH_ENABLED=false
# Keep false unless a verified proxy strips and rewrites x-forwarded-for.
TRUST_PROXY_HEADERS=false

# Public Supabase configuration (safe to expose only when it belongs to the intended project).
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only owned database configuration. Keep the database on a private
# operator-controlled network; never use a hosted database URL for production.
DATABASE_PROVIDER=disabled
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
# Public CA certificate used to verify the private PostgreSQL server; never put a private key here.
DATABASE_CA_CERT=
DATABASE_ALLOWED_HOSTS=
DIRECT_DATABASE_URL=

# Compatibility-only prototype settings. Leave empty for the owned deployment.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SEEV_CHECKOUT_API_KEY=
SEEV_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
SPORTS_DATA_API_KEY=

# Default-deny production activation gates. Do not set these true without written approval.
REAL_MONEY_OPERATIONAL_AUTHORIZATION=
GAMING_AUTHORIZATION_VERIFIED=false
PAYMENT_PROVIDER_APPROVED=false
SAFEGUARDING_VERIFIED=false
SECURITY_REVIEW_VERIFIED=false

# The local server still reads these legacy demo variables for compatibility.
PEERARENA_REAL_MONEY_ENABLED=false
